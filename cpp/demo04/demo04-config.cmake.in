@PACKAGE_INIT@

set(DEMO03_VERSION "@DEMO03_VERSION@")
set_and_check(DEMO03_INCLUDE_DIR "@PACKAGE_CONFIG_INC_DIR@")
set_and_check(DEMO03_LIB_DIR "@PACKAGE_CONFIG_LIB_DIR@")

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/demo03-targets.cmake")
    include ("${CMAKE_CURRENT_LIST_DIR}/demo03-targets.cmake")
endif()

check_required_components(demo03)